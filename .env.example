# Copy to .env.local and fill in. These are read server-side only.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
# PROFILER_MODEL=claude-haiku-5-5
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium        # low | medium | high | xhigh | max
# GEMINI_MODEL=gemini-flash-latest

# Demo mode: the three sample CSVs replay analyses pre-computed by Claude Opus 5.5
# (no API calls; queries still run on the in-browser DuckDB). Other CSVs run live.
# NEXT_PUBLIC_DEMO_MODE=on          # "off" to always run live
# NEXT_PUBLIC_DEMO_BADGE=on         # small "Demo" chip in the header
# NEXT_PUBLIC_DEMO_SPEED=1          # playback speed multiplier (2 = twice as fast)

# Real-time voice (Gemini Live API). The browser gets a single-use session token from
# /api/live-token, so the key above never reaches the client.
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Kore            # e.g. Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
